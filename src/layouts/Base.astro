---
import '../styles/global.css';
import '../styles/v4.css';
import { meta as DM } from '../lib/data';
interface Props { title: string; description: string; active?: string; crumbs?: [string, string?][]; jsonld?: object; noindex?: boolean; bodyClass?: string; ogImage?: string }
const { title, description, active = '', crumbs = [], jsonld, noindex = false, bodyClass = '', ogImage: ogIn } = Astro.props;
import F from '../data/founder.json';
const SITE = '新竹房產情報站';
const HOME_TITLE = '新竹房產情報站｜新竹房價、實價登錄、房市新聞與重大建設';
const fullTitle = title === SITE || title === HOME_TITLE ? HOME_TITLE : `${title}｜${SITE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogIn ?? '/og.png', Astro.site).href;
// 手機抽屜選單：分組，每一項附一句說明（桌機改用下方攤開的分類列，不用下拉選單）
type Item = [string, string, string]; // [網址, 名稱, 說明]
const groups: { id: string; label: string; items: Item[] }[] = [
  { id: 'market', label: '房價行情', items: [
    ['/region/', '各區房價', '中古屋依屋齡、預售屋每坪中位數'],
    ['/volume/', '交易量', '各區每年成交棟數與官方移轉棟數'],
    ['/rent/', '租金行情', '各區月租、逐年變化與租金報酬率'],
    ['/presale/', '社區建案', '預售建案每一戶的樓層、坪數、車位價'],
    ['/areas/', '新竹生活圈', '竹科、高鐵特區、舊城怎麼選'],
  ] },
  { id: 'news', label: '新聞與政策', items: [
    ['/news/', '房市新聞', '每則新聞對新竹買方的意義'],
    ['/weekly/', 'Simon 新竹房市週報', '每週一整理成交、預售與新聞'],
    ['/construction/', '重大建設', '交通、園區、重劃區的官方進度'],
    ['/policy/', '房貸政策', '央行利率、房貸成數、青安'],
    ['/calendar/', '更新日曆', '實價登錄與政策發布日期'],
  ] },
  { id: 'learn', label: '工具與觀點', items: [
    ['/tools/', '免費工具', '房貸、負擔能力、買房總成本試算'],
    ['/viewpoint/', 'Simon 哥觀點', '實戰案例、建案拆解與市場觀察'],
    ['/guide/', '買房指南', '首購、稅費、學區、驗屋'],
    ['/community/', '交流平台', '問站長、討論區'],
  ] },
  { id: 'about', label: '關於', items: [
    ['/about-simonhc/', '關於 SimonHC', '網站使命、編輯方式與透明度'],
    ['/about/', '關於 Simon 哥', '創辦人背景與實戰經驗'],
    ['/sources/', '資料來源與統計方法', '每個數字怎麼算出來的'],
  ] },
];
const direct: Item[] = [];
// 依網址第一段判斷目前在哪個區塊（不用每頁傳 active）
const SEG: Record<string, string> = { volume: 'region', rent: 'region', developer: 'presale', weekly: 'news', calendar: 'news', tag: 'viewpoint', guide: 'viewpoint',
  about: 'about-simonhc', sources: 'about-simonhc', editorial: 'about-simonhc', privacy: 'about-simonhc', terms: 'about-simonhc', report: 'about-simonhc' };
const segOf = (u: string) => { const s = u.split('/')[1] || 'home'; return SEG[s] ?? s; };
const cur = segOf(Astro.url.pathname);
const isOn = (u: string) => segOf(u) === cur;
// 分類列：品牌規劃的十個入口，直接攤開
const catnav: (Item | null)[] = [
  ['/', '首頁', 'view'], ['/region/', '房價行情', 'price'], ['/presale/', '社區建案', 'build'], ['/areas/', '新竹生活圈', 'life'], ['/school/', '學區房', 'life'], ['/news/', '房市新聞', 'news'],
  ['/construction/', '重大建設', 'con'], ['/policy/', '房貸政策', 'policy'], ['/tools/', '免費工具', 'tool'], ['/viewpoint/', 'Simon 哥觀點', 'view'],
];
const upd = DM.synced;
const ASSET_V = Date.now().toString(36);
const C = F.contact as Record<string, string>;
const social: [string, string | undefined][] = [['Facebook', C.facebook], ['Instagram', C.instagram], ['YouTube', C.youtube], ['Threads', C.threads], ['TikTok', C.tiktok], ['LINE', C.line]];
const orgLd = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': new URL('/#org', Astro.site).href, name: '新竹房產情報站', alternateName: ['Hsinchu Real Estate Insights', 'SimonHC', 'SimonHC 新竹房產情報站'],
  url: Astro.site?.href, logo: new URL('/favicon.svg', Astro.site).href, slogan: '深耕新竹，讓房產資訊更透明。',
  founder: { '@type': 'Person', '@id': new URL('/about/#simon', Astro.site).href, name: 'Simon 哥（Simon Chao）', alternateName: 'Simon價差房產', url: new URL('/about/', Astro.site).href },
  sameAs: social.map(([, u]) => u).filter(Boolean),
};
const tabs: [string, string, string][] = [['/region/', '房價', 'M3 20V9l9-6 9 6v11h-6v-6H9v6z'], ['/presale/', '預售', 'M4 21V7h4V3h8v4h4v14M9 11h2m2 0h2m-6 4h2m2 0h2'], ['', '搜尋', 'M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM20 20l-4.8-4.8'], ['/tools/', '試算', 'M6 3h12v18H6zM9 7h6M9 11h1m2 0h1m2 0h0M9 15h1m2 0h1m2 0h0'], ['/guide/', '指南', 'M4 5c3-1 6-1 8 1 2-2 5-2 8-1v14c-3-1-6-1-8 1-2-2-5-2-8-1zM12 6v14']];
const crumbLd = crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [['首頁', '/'], ...crumbs].map(([name, href], i) => ({
    '@type': 'ListItem', position: i + 1, name, ...(href ? { item: new URL(href, Astro.site).href } : {}),
  })),
} : null;
---
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:site_name" content="新竹房產情報站" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#122B40" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@700;900&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body class={bodyClass}>
  <a class="skip" href="#content">跳到主要內容</a>
  <header class="hd"><div class="hd-in">
    <a class="brand" href="/" aria-label="新竹房產情報站 首頁"><svg class="mk" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="4" fill="#1D3A52"/><path d="M8 19 20 9l12 10" fill="none" stroke="#D4A04B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 31v-7M17 31v-11M22 31v-5M27 31v-9" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>
      <span><b class="zh">新竹房產情報站</b><span class="en">HSINCHU REAL ESTATE INSIGHTS<span class="by">由 Simon 哥創立</span></span></span></a>
    <nav class="mainnav" id="mainnav" aria-label="主選單">
      {groups.map((g) => (
        <div class:list={['grp', { on: g.items.some(([u]) => isOn(u)) }]}>
          <button class="gbtn" type="button" aria-expanded="false">{g.label}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg></button>
          <div class="panel">{g.items.map(([u, t, d]) => <a class:list={{ on: isOn(u) }} href={u}><b>{t}</b><span>{d}</span></a>)}</div>
        </div>
      ))}
      <a class="gl ask-m" href="/community/#ask">問站長一個問題</a>
    </nav>
    <div class="hd-meta">
      <span class="upd">資料更新 <b>{upd.slice(5).replace('-', '/')}</b></span>
      <a href="/about/">關於 Simon 哥</a>
      {C.facebook && <a class="soc-i" href={C.facebook} rel="me noopener" target="_blank" aria-label="Facebook 粉絲專頁"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3c-2.8 0-4 1.8-4 4.3V10H7v4h3v8h4v-8h3l.6-4H14V8.6c0-.4.3-.6.6-.6z"/></svg></a>}
      {C.instagram && <a class="soc-i" href={C.instagram} rel="me noopener" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm0 2a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm5 3.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm0 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM17 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg></a>}
      {C.youtube && <a class="soc-i" href={C.youtube} rel="me noopener" target="_blank" aria-label="YouTube 頻道"><svg viewBox="0 0 24 24"><path d="M21.6 7.2c-.2-1-1-1.7-2-1.9C17.9 5 12 5 12 5s-5.9 0-7.6.3c-1 .2-1.8.9-2 1.9C2 8.9 2 12 2 12s0 3.1.4 4.8c.2 1 1 1.7 2 1.9 1.7.3 7.6.3 7.6.3s5.9 0 7.6-.3c1-.2 1.8-.9 2-1.9.4-1.7.4-4.8.4-4.8s0-3.1-.4-4.8zM10 15V9l5.2 3z"/></svg></a>}
    </div>
    <button class="sbtn" type="button" data-search-open aria-label="搜尋"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM20 20l-4.8-4.8" /></svg><span>搜尋區域、建案、文章</span><kbd>/</kbd></button>
    <button class="menubtn" type="button" aria-controls="mainnav" aria-expanded="false"><i></i><i></i><i></i><span class="sr">選單</span></button>
  </div>
  <nav class="catnav" aria-label="主要功能"><div class="cat-in">
    {catnav.map((c) => c && <a class:list={[`t-${c[2]}`, { on: isOn(c[0]) }]} href={c[0]} aria-current={isOn(c[0]) ? 'page' : undefined}>{c[1]}</a>)}
  </div></nav>
  </header>
<main id="content">
    {crumbs.length > 0 && (
      <div class="crumb"><a href="/">首頁</a>{crumbs.map(([n, h]) => <> › {h ? <a href={h}>{n}</a> : n}</>)}</div>
    )}
    <slot />
  </main>
  <footer>
    <div class="ft5">
      <div class="fb">
        <div class="zh">新竹房產情報站</div>
        <div class="en">HSINCHU REAL ESTATE INSIGHTS</div>
        <p><span class="by">由 Simon 哥創立</span>・深耕新竹，讓房產資訊更透明。<br />免費整理新竹縣市實價登錄、預售建案、租金、生活圈、房市新聞與重大建設，不收費、不需註冊。</p>
        <p>看懂價差，先算風險。—— Simon價差房產</p>
      </div>
      <div><h4>快速入口</h4><a href="/region/">房價行情</a><a href="/presale/">社區建案</a><a href="/areas/">新竹生活圈</a><a href="/school/">學區房</a><a href="/news/">房市新聞</a><a href="/construction/">重大建設</a><a href="/policy/">房貸政策</a><a href="/tools/">免費工具</a><a href="/weekly/">房市週報</a></div>
      <div><h4>資料來源與透明度</h4><a href="/sources/">資料來源與統計方法</a><a href="/editorial/">內容編輯政策</a><a href="/about-simonhc/#visits">造訪統計方法</a><a href="/report/">資料錯誤回報</a><a href="/calendar/">資料更新日曆</a><a href="/about-simonhc/#images">圖片來源與授權</a></div>
      <div><h4>創辦人與社群</h4><a href="/about/">關於 Simon 哥</a><a href="/viewpoint/">Simon 哥觀點</a><a href="/community/#ask">問站長一個問題</a>
        <div class="soc">{social.filter(([, u]) => u).map(([n, u]) => <a href={u} rel="me noopener" target="_blank">{n}</a>)}{C.email && <a href={`mailto:${C.email}`} data-mail={C.email}>Email</a>}</div></div>
    </div>
    <div class="ft-stats" data-visits>
      <span><span class="k">累計造訪</span><span class="v" data-k="visits">—</span></span>
      <span><span class="k">今日造訪</span><span class="v" data-k="today">—</span></span>
      <span><span class="k">本月造訪</span><span class="v" data-k="month">—</span></span>
      <span><span class="k">累計頁面瀏覽</span><span class="v" data-k="views">—</span></span>
      <span class="how"><span data-k="state">統計資料載入中</span>・<a href="/about-simonhc/#visits">統計方法</a></span>
    </div>
    <div class="ft-bottom"><span>© {new Date().getFullYear()} 新竹房產情報站（SimonHC）・非政府官方網站，資料僅供一般參考，不構成估價或投資建議。</span><span><a href="/privacy/">隱私權政策</a>・<a href="/terms/">使用條款</a>・實價登錄更新 {upd}</span></div>
  </footer>
  <nav class="tabbar" aria-label="快速導覽">
    {tabs.map(([u, t, d]) => u
      ? <a class:list={{ on: isOn(u) }} href={u}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} /></svg>{t}</a>
      : <button type="button" data-search-open><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} /></svg>{t}</button>)}
  </nav>
  <div class="srch" id="srch" hidden>
    <div class="srch-box" role="dialog" aria-modal="true" aria-label="站內搜尋">
      <div class="srch-in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM20 20l-4.8-4.8" /></svg><input id="srch-q" type="search" placeholder="輸入區域、建案、建商或問題，例如：竹北、寬限期" autocomplete="off" /><button type="button" class="srch-x" data-search-close>關閉</button></div>
      <div class="srch-res" id="srch-res" role="listbox"></div>
      <div class="srch-ft"><span><kbd>↑</kbd><kbd>↓</kbd> 選擇</span><span><kbd>Enter</kbd> 打開</span><span><kbd>Esc</kbd> 關閉</span></div>
    </div>
  </div>
  <script is:inline src={`/site.js?v=${ASSET_V}`} defer></script>
  <script is:inline src="/visits.js" defer></script>
</body>
</html>
