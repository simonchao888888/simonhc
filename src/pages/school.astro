---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { meta, schoolStats } from '../lib/data';
const y1 = (() => { const d = new Date(meta.latestDeal); d.setFullYear(d.getFullYear() - 1); return d.toISOString().slice(0, 10); })();
const period = `${y1.replace(/-/g, '/')}～${meta.latestDeal.replace(/-/g, '/')}`;
type Row = { id: string; es: string; js: string; area: string; roads: string; note?: string };
const GROUPS: { t: string; city: string; dist: string; lead: string; rows: Row[]; official: [string, string][] }[] = [
  { t: '竹北市', city: '新竹縣', dist: '竹北市', lead: '竹北是科技業家庭最集中的學區。縣治二期的成功、勝利國中長年總量管制，戶籍遷入時間不夠久，可能被分發到其他學校。六家高中國中部 115 學年度起停招，原學區學生改分發東興、成功等校。',
    rows: [
      { id: 'zb-dongxing', es: '東興國小・嘉豐國小', js: '東興國中', area: '高鐵特區', roads: '東興路、嘉豐各路街、文興路、高鐵各路、隘口' },
      { id: 'zb-xinglong', es: '興隆國小（雙語）', js: '成功國中', area: '縣治二期', roads: '成功一～九路、自強各街、光明六路東一段、興隆路一二段', note: '總量管制' },
      { id: 'zb-shixing', es: '十興國小（雙語）', js: '勝利國中', area: '遠百・縣治二期', roads: '莊敬各街、勝利各路街、十興路', note: '總量管制' },
      { id: 'zb-boai', es: '博愛國小（雙語）', js: '博愛國中（雙語）', area: '縣治一期', roads: '縣政各路、光明一～十路（不含六路東一段）' },
      { id: 'zb-old', es: '竹北國小・新社國小', js: '竹北國中（雙語）', area: '竹北舊市區', roads: '中央路、中正東西路、中山路、三民路、博愛街、長青路' },
    ],
    official: [['新竹縣國小學區（政府資料開放平臺）', 'https://data.gov.tw/dataset/109378'], ['新竹縣國中學區（政府資料開放平臺）', 'https://data.gov.tw/dataset/109362'], ['新竹縣政府教育處', 'https://doe.hsinchu.gov.tw/']] },
  { t: '新竹市', city: '新竹市', dist: '東區・北區', lead: '新竹市學區以「里鄰」劃分，同一條路的兩側可能分屬不同學校。115 學年度總量管制學校：國中有三民、培英、光武、竹光、建功高中國中部、育賢，國小有三民、關埔。關埔是竹科工程師的首選；東門、新竹國小是傳統明星學區，但周邊多為老公寓，近 10 年的新成屋少。',
    rows: [
      { id: 'hc-guanpu', es: '關埔國小・關東國小', js: '光武國中', area: '關埔重劃區', roads: '關新路、慈濟路、關東路、關埔一帶', note: '關埔國小、光武國中總量管制' },
      { id: 'hc-dongmen', es: '東門國小', js: '三民國中', area: '舊城東門', roads: '府後街、東門街、中正路（東區段）、林森路、大同路、勝利路', note: '三民國中總量管制' },
      { id: 'hc-hsinchu', es: '新竹國小', js: '育賢國中', area: '南大路・振興路', roads: '振興路、南門街、南大路（300 號以前）、關帝廟一帶', note: '育賢國中總量管制' },
      { id: 'hc-jinya', es: '舊社國小・載熙國小', js: '光華國中', area: '金雅重劃區', roads: '金雅、金竹、舊社、鐵道路二段' },
      { id: 'hc-nanliao', es: '南寮國小', js: '南華國中', area: '南寮', roads: '西濱路、東大路三段、海濱路' },
    ],
    official: [['新竹市國民中小學學區劃分（新竹市教育網）', 'https://www.hc.edu.tw/edub/basic/schoolarea/']] },
  { t: '新豐鄉', city: '新竹縣', dist: '新豐鄉', lead: '坪頂・明新重劃區是新豐近年的新案主力，鄰近湖口工業區與竹北，總價比竹北低一大截。',
    rows: [{ id: 'xf-songlin', es: '松林國小（雙語）', js: '忠孝國中', area: '坪頂・明新重劃區', roads: '明新各街、松林、坪頂' }],
    official: [['新竹縣國小學區（政府資料開放平臺）', 'https://data.gov.tw/dataset/109378'], ['新竹縣國中學區（政府資料開放平臺）', 'https://data.gov.tw/dataset/109362']] },
];
const fmt = (v: number | null | undefined) => (v == null ? '—' : v.toFixed(1));
const prem = (s: any) => (s?.used != null && s?.distMed ? Math.round((s.used / s.distMed - 1) * 100) : null);
const all = GROUPS.flatMap((g) => g.rows.map((r) => ({ ...r, g: g.t, s: schoolStats[r.id] }))).filter((r) => r.s?.used != null).sort((a, b) => b.s.used - a.s.used);
const max = Math.max(...all.map((r) => r.s.used));
---
<Base title="新竹學區房價格｜竹北、新竹市、新豐熱門學區單價分析" description="新竹縣市熱門學區整理：竹北東興、成功、勝利、博愛，新竹市關埔、東門、新竹國小、金雅，新豐松林。附學區房近一年中古屋每坪中位數、10 年內屋單價、與行政區價差及官方學區查詢連結。" active="school" crumbs={[['學區房']]}>
  <PageBanner img="zhubei-tofu" tone="life" kicker="新竹學區房" title="新竹熱門學區與學區房單價" lead="竹北、新竹市、新豐 11 個熱門國中小學區：各學區附近的中古屋單價、比行政區貴多少，以及官方學區要去哪裡查。" />

  <div class="card sch-warn">
    <strong>看數字之前</strong>
    <p>官方學區由縣市政府依「村里、鄰」劃分，每學年可能調整。實價登錄只有門牌、沒有村里，所以本頁的學區房單價是用各校周邊的<b>代表路段</b>歸類成交（近一年 {period}，中古屋、扣車位，少於 10 筆不給數字），屬於估算，<b>不是官方學區認定</b>。買房前請用門牌向戶政事務所確認村里鄰，再對照下方的官方學區表；總量管制學校另須確認設籍年限。</p>
  </div>

  <section class="sx t-life"><div class="sx-h"><h2>學區房單價排行</h2><p>近一年中古屋每坪中位數（萬元）</p></div>
    <div class="sch-bars">{all.map((r) => (
      <a class="sch-bar" href={`#s-${r.id}`}>
        <span class="nm">{r.es.replace(/（.*?）/g, '')}<small>{r.g}・{r.area}</small></span>
        <span class="tr"><span class="fl" style={`width:${(r.s.used / max) * 100}%`}></span></span>
        <span class="v">{fmt(r.s.used)}</span>
      </a>
    ))}</div>
  </section>

  {GROUPS.map((g) => (
    <section class="sx t-life" id={g.t}><div class="sx-h"><h2>{g.t}學區</h2><p>{g.city}</p></div>
      <p class="sch-lead">{g.lead}</p>
      <div class="sch-wrap"><table class="sch-t">
        <thead><tr><th>國小 → 國中</th><th>區域・代表路段</th><th class="r">學區房單價</th><th class="r">10 年內屋</th><th class="r">比行政區</th><th class="r">筆數</th></tr></thead>
        <tbody>{g.rows.map((r) => { const s = schoolStats[r.id]; const p = prem(s); return (
          <tr id={`s-${r.id}`}>
            <td><b>{r.es}</b><br />→ {r.js}{r.note && <span class="sch-flag">{r.note}</span>}</td>
            <td>{r.area}<br /><small class="note">{r.roads}</small></td>
            <td class="r" data-l="學區房單價"><b>{s?.used != null ? fmt(s.used) : '樣本不足'}</b></td>
            <td class="r" data-l="10 年內屋">{s?.ages?.['0-10']?.med != null && s.ages['0-10'].n >= 10 ? fmt(s.ages['0-10'].med) : '—'}</td>
            <td class="r" data-l="比行政區">{p == null ? '—' : <span class={p > 0 ? 'up' : p < 0 ? 'dn' : ''}>{p > 0 ? '+' : ''}{p === 0 ? '持平' : `${p}%`}</span>}</td>
            <td class="r" data-l="筆數">{s?.n ?? 0}</td>
          </tr>
        ); })}</tbody>
      </table></div>
      <p class="note">單價單位：萬元／坪。「比行政區」是學區房單價對比所在行政區同期整體中古屋中位數；「10 年內屋」少於 10 筆不顯示。官方學區：{g.official.map(([t, u], i) => <>{i > 0 && '、'}<a href={u} target="_blank" rel="noopener">{t}</a></>)}</p>
    </section>
  ))}

  <section class="sx t-life"><div class="sx-h"><h2>看學區買房的 5 個提醒</h2><a class="more" href="/guide/school-district/">完整教學：總量管制與設籍時間</a></div>
    <ol class="sch-tips">
      <li><b>學區看村里鄰，不看路名。</b>同一條路、甚至同一社區的不同棟，都可能分屬不同學校。用門牌向戶政事務所查村里鄰最準。</li>
      <li><b>總量管制要看設籍時間。</b>竹北成功、勝利國中，新竹市關埔國小、光武國中等總量管制學校，額滿時依設籍先後分發，新遷入不保證能就讀。</li>
      <li><b>學區每學年會調整。</b>竹北人口成長快，新校成立或停招（例如六家高中國中部 115 學年度停招）都會改變學區。</li>
      <li><b>預售屋交屋時孩子幾歲？</b>預售案 3～4 年後才交屋，先算清楚入學年度與設籍時間是否來得及。</li>
      <li><b>學區溢價也反映在轉手。</b>熱門學區單價高、轉手快，但進場成本也高，可對照<a href="/areas/">生活圈</a>與<a href="/region/">行政區房價</a>一起看。</li>
    </ol>
  </section>
</Base>
<style>
  .sch-warn{border-left:4px solid var(--c-life,#2E7D6B);margin:0 0 22px}.sch-warn p{margin:6px 0 0}
  .sch-lead{max-width:70ch}
  .sch-bars{display:grid;gap:8px}
  .sch-bar{display:grid;grid-template-columns:minmax(150px,220px) 1fr 54px;align-items:center;gap:12px;color:inherit;text-decoration:none}
  .sch-bar .nm{font-weight:600;line-height:1.25}.sch-bar .nm small{display:block;font-weight:400;color:var(--sub);font-size:.8em}
  .sch-bar .tr{height:14px;background:#E8EEF3;border-radius:7px;overflow:hidden}
  .sch-bar .fl{display:block;height:100%;background:var(--navy,#122B40);border-radius:7px}
  .sch-bar:hover .fl{background:var(--c-life,#2E7D6B)}
  .sch-bar .v{text-align:right;font-variant-numeric:tabular-nums;font-weight:700}
  .sch-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px}
  .sch-t{min-width:640px}.sch-t td,.sch-t th{vertical-align:top;padding:10px 12px;border-bottom:1px solid var(--line);text-align:left}
  .sch-t .r{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  .sch-t tr:target td{background:#FFF8E6}
  .sch-flag{display:inline-block;margin-left:6px;padding:1px 6px;border-radius:4px;background:#FCEBDD;color:#9A4A10;font-size:.75em}
  .up{color:#B3361F}.dn{color:#2C6E9B}
  .sch-tips li{margin:0 0 10px;max-width:72ch}
  @media (max-width:640px){
    .sch-bar{grid-template-columns:110px 1fr 44px;gap:8px}
    .sch-t{min-width:0}.sch-t thead{display:none}
    .sch-t tr{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line)}
    .sch-t td{border:0;padding:8px 12px}.sch-t td:nth-child(-n+2){grid-column:1/-1}.sch-t td:nth-child(2){padding-top:0}
    .sch-t td.r{text-align:left;display:flex;justify-content:space-between;gap:8px;padding-top:4px;padding-bottom:4px}
    .sch-t td.r::before{content:attr(data-l);color:var(--sub);font-size:.85em}
    .sch-t tr td:last-child{padding-bottom:12px}
  }
</style>
