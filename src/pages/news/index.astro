---
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import Photo from '../../components/Photo.astro';
import PageBanner from '../../components/PageBanner.astro';
import { news, feedData, fmtDate, newsUpdated, newsRuns } from '../../lib/news';
import { newsImg, CAT_TONE } from '../../lib/images';

// 分欄：依新聞分類與標題關鍵字歸到 V4 新聞中心的版面分類
const SECT: [string, string, (c: string, t: string) => boolean][] = [
  ['新竹市房市', 'news', (c, t) => /新竹市|東區|北區|香山|關埔|巨城/.test(t) || (c === '新竹市場' && /新竹縣市|新竹/.test(t) && !/新竹縣(?!市)/.test(t))],
  ['新竹縣房市', 'news', (c, t) => /新竹縣|竹北|竹東|湖口|新豐|寶山/.test(t)],
  ['中央銀行政策', 'policy', (c) => c === '央行政策'],
  ['房貸與金融', 'policy', (c) => /房貸|貸款|青安/.test(c)],
  ['重大建設', 'con', (_, t) => /建設|輕軌|車站|園區/.test(t)],
  ['科學園區及產業', 'life', (_, t) => /竹科|台股|半導體|AI/.test(t)],
];
const sectOf = (c: string, t: string) => SECT.filter(([, , f]) => f(c, t)).map(([n]) => n);
const tone = (c: string) => `t-${CAT_TONE[c] ?? 'news'}`;
const top = news[0], seconds = news.slice(1, 4), rest = news.slice(4);
// 快訊：新的 feed 有 scope（新竹／全國政策）；舊格式退回關鍵字判斷
const isHc = (f: any) => f.scope ? f.scope === 'hsinchu' : /新竹|竹北|竹科|竹東|湖口|新豐|寶山/.test(f.title);
const okOld = (f: any) => f.scope || (/房|青安|央行|預售|新竹|竹北/.test(f.title) && !/美國|日本|中國|香港|韓國|加拿大/.test(f.title));
const wireHc = feedData.items.filter((f) => okOld(f) && isHc(f)).slice(0, 12);
const wireNat = feedData.items.filter((f) => okOld(f) && !isHc(f)).slice(0, 12);
const lastRun = newsRuns[0];
---
<Base title="新竹房市新聞與最新政策" description="新竹房市新聞中心：新竹市與新竹縣房市、央行政策、房貸與金融、重大建設與竹科產業新聞，每則附原創摘要、Simon 哥判讀與原文來源。" crumbs={[['房市新聞']]}>
  <PageBanner img="tra-hsinchu-night" tone="news" kicker="新竹房市新聞中心" title="新竹房市新聞中心" lead="只收和新竹房市有關的新聞。每則有原創摘要、對新竹買方的判讀與原文連結；自動彙整的快訊另外標示「尚未判讀」。" />
  <p class="note">判讀更新：{fmtDate(newsUpdated)}・<a href="#flash">最新快訊</a>每小時自動檢查（{feedData.updated}）・新聞照片除特別註明外皆為主題資料照，不是新聞事件現場。</p>

  <section class="nc-top">
    <a class:list={['lead-story', tone(top.cat)]} href={`/news/${top.id}/`}>
      <Photo id={newsImg(top.cat, top.title)?.id} ratio="16/9" sizes="(max-width: 900px) 100vw, 720px" nested note="資料照" badge="資料照" />
      <h3>{top.title}</h3><p>{top.summary}</p>
      <div class="meta-l"><span class="chip">{top.cat}</span><time datetime={top.date}>{fmtDate(top.date)}</time><span>來源：{top.sources.map((s) => s[0]).slice(0, 3).join('、')}</span><span class="ai">AI 輔助整理・編輯部審核</span></div>
    </a>
    <div class="side-stories">
      {seconds.map((x) => (
        <a class:list={['mid-story', tone(x.cat)]} href={`/news/${x.id}/`}>
          <Photo id={newsImg(x.cat, x.title)?.id} ratio="4/3" sizes="140px" credit="none" badge="資料照" />
          <div><span class="chip">{x.cat}</span><h3>{x.title}</h3><div class="meta-l" style="margin-top:4px"><time datetime={x.date}>{fmtDate(x.date)}</time></div></div>
        </a>
      ))}
    </div>
  </section>


  <section class="sx t-news wire5" id="flash" aria-labelledby="flash-h">
    <div class="sx-h"><h2 id="flash-h">最新快訊</h2><p>自動彙整、尚未判讀，請點原文閱讀。同一事件多家報導已合併；海外房市與只談其他縣市的報導不收。</p></div>
    <p class="note w-upd">最後更新 {feedData.updated ?? '—'}{lastRun && <>・每小時自動檢查，最近一次 {lastRun.at}（{lastRun.status === 'ok' ? `成功：抓到 ${lastRun.fetched} 則、排除 ${lastRun.dropped} 則、合併 ${lastRun.merged} 則` : '失敗，保留上一版'}）</>}・<a href="https://github.com/simonchao888888/simonhc/actions/workflows/update-news.yml" target="_blank" rel="noopener">執行紀錄</a></p>
    <div class="w-cols">
      {[['新竹房市快訊', wireHc], ['影響新竹買方的全國政策', wireNat]].map(([t, list]: any) => (
        <div class="w-col"><h3>{t}</h3>
          {list.length ? <ol class="wire-l">{list.map((f: any) => (
            <li><a href={f.link} rel="nofollow noopener" target="_blank">{f.title}</a>
              <span class="ms">{f.source}・{f.date.slice(5).replace('-', '/')}{f.time ? ` ${f.time}` : ''}{f.topic && f.topic !== '新竹房市' ? `・${f.topic}` : ''}</span>
              {f.also?.length > 0 && <details class="also"><summary>另有 {f.also.length} 家報導</summary>{f.also.map((a: any) => <a href={a.link} rel="nofollow noopener" target="_blank">{a.source}</a>)}</details>}
            </li>
          ))}</ol> : <p class="note">目前沒有新的相關報導。</p>}
        </div>
      ))}
    </div>
  </section>

  <div class="nc-tabs" id="filter" role="tablist">
    <button class="on" data-c="all">全部新聞</button>
    {SECT.map(([n, t]) => <button class={`t-${t}`} data-c={n}>{n}</button>)}
  </div>
  <div id="list">
    {news.map((n) => (
      <article class:list={['nrow', tone(n.cat)]} data-c={sectOf(n.cat, n.title).join('|')}>
        <Photo id={newsImg(n.cat, n.title)?.id} ratio="16/10" sizes="(max-width: 700px) 100vw, 240px" badge="資料照" />
        <div>
          <div class="meta-l" style="margin:0"><span class="chip">{n.cat}</span>{sectOf(n.cat, n.title).filter((s) => s !== n.cat).slice(0, 2).map((s) => <span>{s}</span>)}<time datetime={n.date}>{fmtDate(n.date)}</time><span class="ai">AI 輔助整理・編輯部審核</span></div>
          <h3><a href={`/news/${n.id}/`}>{n.title}</a></h3>
          <p>{n.summary}</p>
          <div class="take"><b>Simon 哥判讀：</b>{n.take}</div>
          <div class="act"><b>怎麼做：</b>{n.action}</div>
          <Sources list={n.sources} />
        </div>
      </article>
    ))}
  </div>

</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('#filter button');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    document.querySelectorAll<HTMLElement>('#list article').forEach((a) => {
      a.style.display = b.dataset.c === 'all' || (a.dataset.c ?? '').split('|').includes(b.dataset.c!) ? '' : 'none';
    });
  }));
</script>
