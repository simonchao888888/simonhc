---
import PageBanner from '../components/PageBanner.astro';
import Base from '../layouts/Base.astro';
import C from '../data/community.json';
---
<Base title="資料錯誤回報" description="發現新竹房產情報站的房價、建案、建設或文章資料有誤，請在這裡回報。" crumbs={[['關於本站', '/about-simonhc/'], ['資料錯誤回報']]}>
  <PageBanner tone="view" kicker="網站透明度" title="資料錯誤回報" lead="看到數字對不上、建案名稱錯誤或建設進度過時，請告訴我們。確認後會修正並在該頁註明更正日期。" />
  <form class="card" method="POST" action={C.form.endpoint} style="max-width:640px">
    <input type="hidden" name="_subject" value="【新竹房產情報站】資料錯誤回報" />
    <input type="hidden" name="_template" value="table" />
    <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
    <div class="field"><label for="r-url">哪一頁？（網址或頁面名稱）</label><input id="r-url" name="頁面" required /></div>
    <div class="field"><label for="r-what">哪裡有誤？正確資訊是什麼？</label><textarea id="r-what" name="內容" rows="5" required style="width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:6px;font:inherit"></textarea></div>
    <div class="field"><label for="r-src">佐證來源（選填）</label><input id="r-src" name="來源" /></div>
    <div class="field"><label for="r-mail">Email（選填，需要回覆時才填）</label><input id="r-mail" name="email" type="email" /></div>
    <button class="btn p" type="submit">送出回報</button>
  </form>
  <p class="note">也可以直接寫信到 <a href="mailto:simon.chao888@gmail.com?subject=新竹房產情報站%20資料錯誤回報" data-mail="simon.chao888@gmail.com" data-subject="新竹房產情報站 資料錯誤回報">simon.chao888@gmail.com</a>。表單資料只用於處理這次回報，詳見<a href="/privacy/">隱私權政策</a>。</p>
</Base>
